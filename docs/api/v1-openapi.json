    "/api/v1/changes/{change_id}/evaluation-runs/preview-csv": {
      "post": {
        "summary": "Evaluation Csv Preview",
        "description": "Validate synthetic CSV against the saved suite. Does not execute or persist evaluations.",
        "operationId": "evaluation_csv_preview_api_v1_changes__change_id__evaluation_runs_preview_csv_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "change_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Change Id"
            }
          },
          {
            "in": "header",
            "name": "X-Expected-Revision",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^[1-9][0-9]*\\z",
              "title": "X-Expected-Revision",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CaseProof-Request-Context",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ready to submit or structured CSV diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "ready": {
                          "title": "Ready",
                          "type": "boolean"
                        },
                        "revision": {
                          "maximum": 9007199254740991,
                          "minimum": 1,
                          "title": "Revision",
                          "type": "integer"
                        },
                        "errors": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "row": {
                                "anyOf": [
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "title": "Row"
