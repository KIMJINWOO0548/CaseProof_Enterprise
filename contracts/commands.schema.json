{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target command DTOs and extracted protocol headers",
  "description": "PLANNED /api/v1 target contract. This is not the running /api OpenAPI or proof of runtime enforcement.",
  "x-contract-status": "PLANNED",
  "$defs": {
    "CreateChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "pack_version_id": {"$ref": "common.schema.json#/$defs/RegisteredId"},
        "product_id": {"$ref": "common.schema.json#/$defs/RegisteredId"},
        "workflow": {"$ref": "common.schema.json#/$defs/RegisteredId"},
        "rule_key": {"$ref": "common.schema.json#/$defs/RegisteredId"},
        "candidate_snapshot_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "source_bundle_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "dataset_version_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "suite_version_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "evaluator_version_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "parent_change_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/UUIDv4"}, {"type": "null"}], "default": null},
        "parent_relation": {"anyOf": [{"$ref": "common.schema.json#/$defs/ParentRelation"}, {"type": "null"}], "default": null}
      },
      "required": [
        "title",
        "pack_version_id",
        "product_id",
        "workflow",
        "rule_key",
        "candidate_snapshot_id",
        "source_bundle_id",
        "dataset_version_id",
        "suite_version_id",
        "evaluator_version_id"
      ],
      "oneOf": [
        {"properties": {"parent_change_id": {"type": "null"}, "parent_relation": {"type": "null"}}},
        {
          "required": ["parent_change_id", "parent_relation"],
          "properties": {
            "parent_change_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
            "parent_relation": {"$ref": "common.schema.json#/$defs/ParentRelation"}
          }
        }
      ]
    },
    "RecordEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite_version_id": {"$ref": "common.schema.json#/$defs/UUIDv4"},
        "case_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "case_id": {"$ref": "common.schema.json#/$defs/RegisteredId"},
              "claim_days": {"$ref": "common.schema.json#/$defs/ClaimDays"},
              "case_context": {"$ref": "case-context.schema.json"}
            },
            "required": ["case_id", "claim_days", "case_context"]
          }
        }
      },
      "required": ["suite_version_id", "case_inputs"],
      "x-runtime-rules": [
        "case_id must equal the suite required_case_ids exactly once; uniqueItems cannot enforce case_id uniqueness.",
        "The server resolves model, prompt, source and evaluator from immutable Change snapshots."
      ]
    },
    "SubmitChange": {"type": "object", "additionalProperties": false, "properties": {}, "required": []},
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"decision": {"enum": ["APPROVE", "REJECT"]}, "reason": {"$ref": "common.schema.json#/$defs/Reason"}},
      "required": ["decision", "reason"]
    },
    "CreateHeaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"Idempotency-Key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{12,128}$(?![\\s\\S])"}},
      "required": ["Idempotency-Key"]
    },
    "MutationHeaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Idempotency-Key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{12,128}$(?![\\s\\S])"},
        "X-Expected-Revision": {"type": "string", "pattern": "^[1-9][0-9]*$(?![\\s\\S])"}
      },
      "required": ["Idempotency-Key", "X-Expected-Revision"]
    }
  },
  "x-header-scope": "Headers definitions validate only extracted protocol headers, not all HTTP headers. Header names remain HTTP case-insensitive."
}
