  "components": {
    "schemas": {
      "ChangeCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 5,
            "title": "Title"
          },
          "product": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Product"
          },
          "workflow": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Workflow"
          },
          "rule_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Rule Key"
          },
          "dataset_hash": {
            "type": "string",
            "title": "Dataset Hash"
          },
          "evaluator_hash": {
            "type": "string",
            "title": "Evaluator Hash"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          }
        },
        "type": "object",
        "required": [
          "title",
          "product",
          "workflow",
          "rule_key",
          "dataset_hash",
          "evaluator_hash",
          "source_hash"
        ],
        "title": "ChangeCreate"
      },
      "Decision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 8,
            "title": "Reason",
            "description": "Required reason: both the original and str.strip() result must contain 8–500 Unicode code points; the stripped value is stored."
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "expected_revision",
          "reason",
          "decision"
        ],
        "title": "Decision"
      },
      "EvalRequest": {
        "properties": {
          "claim_days": {
            "type": "integer",
            "maximum": 9999.0,
            "minimum": 0.0,
            "title": "Claim Days",
            "description": "JSON integer only (0–9999); booleans, strings and floats such as 1.0 are rejected at runtime.",
            "x-strict-json-integer": true
          },
          "basis_date": {
            "type": "string",
            "format": "date",
            "title": "Basis Date"
          },
          "rider_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Rider Codes"
          },
          "requested_policy_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Policy Version"
          },
          "as_of_recorded": {
            "type": "string",
            "format": "date-time",
            "title": "As Of Recorded"
          }
        },
        "type": "object",
        "required": [
          "claim_days",
          "basis_date",
          "as_of_recorded"
        ],
        "title": "EvalRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Transition": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "Transition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}