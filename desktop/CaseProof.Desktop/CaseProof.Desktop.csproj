<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CaseProof.Desktop</AssemblyName>
    <RootNamespace>CaseProof.Desktop</RootNamespace>
    <Product>CaseProof Enterprise</Product>
    <Version>0.1.0</Version>
    <Description>CaseProof Enterprise Windows review workspace</Description>
    <ApplicationIcon>assets/caseproof.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets/caseproof.ico" />
  </ItemGroup>
</Project>
