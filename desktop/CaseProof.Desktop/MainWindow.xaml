<Window x:Class="CaseProof.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaseProof Enterprise" Icon="assets/caseproof.ico" Width="1380" Height="860"
        MinWidth="680" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid x:Name="LoginPane" AutomationProperties.AutomationId="LoginPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeRuleBrush}"
                    BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource ChromeMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="작업공간 연결" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource ChromeInkBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                        BorderThickness="1" CornerRadius="10" Width="468"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,22">
                    <StackPanel>
                        <Border Background="{StaticResource QueueBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="24,20,24,18">
                            <StackPanel>
                                <TextBlock Text="검토 작업대에 연결" FontSize="23" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock Text="CaseProof 서버의 역할별 토큰으로 연결하세요." Style="{StaticResource MetaText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="24,20,24,22">
                            <Label Content="서버 주소" Style="{StaticResource InputLabel}" Target="{Binding ElementName=EndpointInput}" />
                            <TextBox x:Name="EndpointInput" AutomationProperties.AutomationId="EndpointInput"
                                     AutomationProperties.Name="서버 주소" Text="http://127.0.0.1:8766" Margin="0,0,0,13" />
                            <Label Content="역할별 접속 토큰" Style="{StaticResource InputLabel}" Target="{Binding ElementName=TokenInput}" />
                            <PasswordBox x:Name="TokenInput" AutomationProperties.AutomationId="TokenInput"
                                         AutomationProperties.Name="역할별 접속 토큰" Margin="0,0,0,14" />
                            <DockPanel LastChildFill="True">
                                <Button x:Name="LoginButton" Content="작업공간 열기" AutomationProperties.AutomationId="LoginButton"
                                        Style="{StaticResource PrimaryButton}" IsDefault="True" DockPanel.Dock="Right" MinWidth="128" />
                                <TextBlock Text="토큰은 연결 중에만 사용됩니다." Style="{StaticResource MetaText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                            </DockPanel>
                            <TextBlock x:Name="LoginStatus" AutomationProperties.AutomationId="LoginStatus"
                                       AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="0,1,0,0" Padding="16,0">
                <TextBlock Text="합성 검토 환경 · 실제 보험 판정이나 운영 배포와 독립된 데모입니다."
                           Style="{StaticResource MetaText}" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Grid x:Name="WorkspacePane" AutomationProperties.AutomationId="WorkspacePane" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="0,0,0,1" Padding="8,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleQueueButton" Content="요청 목록" Tag="&#xE700;" AutomationProperties.AutomationId="ToggleQueueButton"
                                ToolTip="작업 요청 목록 표시 전환 · Ctrl+F" Style="{StaticResource ChromeCommand}" />
                        <Button x:Name="ToggleProofButton" Content="검증 근거" Tag="&#xE8A1;" AutomationProperties.AutomationId="ToggleProofButton"
                                ToolTip="근거와 감사 기록 표시 전환" Style="{StaticResource ChromeCommand}" />
                        <Button x:Name="RefreshButton" Content="새로고침" Tag="&#xE72C;" AutomationProperties.AutomationId="RefreshButton"
                                ToolTip="목록과 선택을 새로고침 · F5" Style="{StaticResource ChromeCommand}" />
                    </StackPanel>
                    <Grid Grid.Column="1" MaxWidth="226" Margin="12,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput" AutomationProperties.AutomationId="SearchInput"
                                 AutomationProperties.Name="제목·요청 ID 검색" Padding="31,3,43,3"
                                 Background="{StaticResource SurfaceBrush}" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="제목·요청 ID 검색" Margin="31,0,44,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Padding="4,0"
                                CornerRadius="3" Background="{StaticResource QueueBrush}" IsHitTestVisible="False">
                            <TextBlock Text="Ctrl+F" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NewChangeButton" Content="새 변경 요청" AutomationProperties.AutomationId="NewChangeButton"
                                Tag="&#xE710;" ToolTip="새 변경 요청 · Ctrl+N" Style="{StaticResource ChromeCommand}" Margin="0,0,5,0" />
                        <TextBlock x:Name="ActorText" AutomationProperties.AutomationId="ActorText"
                                   Style="{StaticResource MetaText}" Foreground="{StaticResource ChromeMutedBrush}"
                                   MaxWidth="116" Margin="2,0,4,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
                        <Button x:Name="SwitchRoleButton" Content="역할 전환" Tag="&#xE8AB;"
                                AutomationProperties.AutomationId="SwitchRoleButton" Style="{StaticResource ChromeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="PaneGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="QueueColumn" Width="216" MaxWidth="390" />
                    <ColumnDefinition x:Name="QueueSplitterColumn" Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ProofSplitterColumn" Width="5" />
                    <ColumnDefinition x:Name="ProofColumn" Width="304" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border x:Name="QueuePane" Background="{StaticResource QueueBrush}" Grid.Column="0"
                        AutomationProperties.AutomationId="QueuePane" AutomationProperties.Name="요청 목록 영역">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="11,10">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,7">
                                    <TextBlock x:Name="QueueSummary" DockPanel.Dock="Right" Text="0건" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="QueueSummary" AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource MetaText}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                               MaxWidth="132" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock Text="작업함" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                                </DockPanel>
                                <ComboBox x:Name="FilterInput" AutomationProperties.AutomationId="FilterInput"
                                          AutomationProperties.Name="검토 상태" Style="{StaticResource QueueFilter}"
                                          SelectedIndex="0" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="모든 상태" Tag="" />
                                    <ComboBoxItem Content="작성·평가" Tag="DRAFT" />
                                    <ComboBoxItem Content="현업 검토 대기" Tag="PENDING_DOMAIN_REVIEW" />
                                    <ComboBoxItem Content="최종 승인 대기" Tag="PENDING_RELEASE" />
                                    <ComboBoxItem Content="반려" Tag="REJECTED" />
                                    <ComboBoxItem Content="데모 승인" Tag="APPROVED_FOR_DEMO" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="QueueList" Grid.Row="1" AutomationProperties.AutomationId="QueueList"
                                 AutomationProperties.Name="변경 요청" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource QueueItemStyle}" Margin="7,6,7,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <DockPanel LastChildFill="True" Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Revision, StringFormat='개정 {0}'}"
                                                       Style="{StaticResource MetaText}" FontSize="11" Margin="8,0,0,0" />
                                            <Ellipse x:Name="QueueStateDot" DockPanel.Dock="Left" Width="6" Height="6"
                                                     Fill="{StaticResource MutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource MetaText}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Pack}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusCode}" Value="PENDING_DOMAIN_REVIEW">
                                            <Setter TargetName="QueueStateDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusCode}" Value="PENDING_RELEASE">
                                            <Setter TargetName="QueueStateDot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusCode}" Value="APPROVED_FOR_DEMO">
                                            <Setter TargetName="QueueStateDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusCode}" Value="REJECTED">
                                            <Setter TargetName="QueueStateDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter x:Name="QueueSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource PaneSplitter}" AutomationProperties.Name="요청 목록 폭 조절" />

                <Grid x:Name="ReviewPane" Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,6,16,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <Border x:Name="StatusBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="neutral">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="hold">
                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="accepted">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="StageText" Text="규칙 변경 검토" AutomationProperties.AutomationId="StageText"
                                           FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=StatusBadge}" Value="neutral">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, ElementName=StatusBadge}" Value="hold">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, ElementName=StatusBadge}" Value="accepted">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock x:Name="ChangeTitle" Text="검토할 변경 요청을 선택하세요"
                                       AutomationProperties.AutomationId="ChangeTitle" AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.HeadingLevel="Level1" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxHeight="48"
                                       TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <TextBlock x:Name="ChangeMeta" Grid.Row="1" Margin="0,2,0,0" AutomationProperties.AutomationId="ChangeMeta"
                                   Style="{StaticResource MetaText}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>

                    <TabControl x:Name="ReviewTabs" Grid.Row="1" Margin="16,0" AutomationProperties.AutomationId="ReviewTabs"
                                AutomationProperties.Name="검토 자료">
                        <TabItem x:Name="EvaluationTab" Header="검증 사례" AutomationProperties.AutomationId="EvaluationTab">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,3,0,3" LastChildFill="True">
                                    <Button x:Name="NextCaseButton" Content="다음 확인 필요" DockPanel.Dock="Right"
                                            AutomationProperties.AutomationId="NextCaseButton" IsEnabled="False" Margin="7,0,0,0" />
                                    <WrapPanel VerticalAlignment="Center">
                                        <ComboBox x:Name="CaseFilterInput" AutomationProperties.AutomationId="CaseFilterInput"
                                                  AutomationProperties.Name="평가 사례 판정 필터" Style="{StaticResource QueueFilter}"
                                                  SelectedIndex="0" SelectedValuePath="Tag" Width="108">
                                            <ComboBoxItem Content="전체 사례" Tag="ALL" AutomationProperties.AutomationId="CaseFilterAll" />
                                            <ComboBoxItem Content="확인 필요" Tag="ATTENTION" AutomationProperties.AutomationId="CaseFilterAttention" />
                                            <ComboBoxItem Content="통과" Tag="PASS" AutomationProperties.AutomationId="CaseFilterPass" />
                                        </ComboBox>
                                        <TextBlock x:Name="CaseFilterSummary" AutomationProperties.AutomationId="CaseFilterSummary"
                                                   AutomationProperties.LiveSetting="Polite" Style="{StaticResource MetaText}"
                                                   Margin="8,0" VerticalAlignment="Center" />
                                        <Button x:Name="ShowCaseInputButton" Content="평가 입력 편집" Visibility="Collapsed"
                                                Margin="0,0,6,0" AutomationProperties.AutomationId="ShowCaseInputButton" />
                                        <Button x:Name="PreviewCsvButton" Content="CSV 점검" Visibility="Collapsed"
                                                AutomationProperties.AutomationId="PreviewCsvButton" />
                                    </WrapPanel>
                                </DockPanel>
                                <DataGrid x:Name="EvaluationGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                                          RowDetailsVisibilityMode="Collapsed"
                                          AutomationProperties.AutomationId="EvaluationGrid" AutomationProperties.Name="평가 사례별 결과">
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource InputRuleBrush}" BorderThickness="2,0,0,1" Padding="8,6"
                                                    Background="{StaticResource CanvasBrush}">
                                                <TextBlock x:Name="InlineEvidenceText" AutomationProperties.AutomationId="InlineEvidenceText"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                                           Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                                <Border x:Name="CaseInputPanel" Grid.Row="2" Visibility="Collapsed"
                                        BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,8,0,0">
                                    <DataGrid x:Name="CaseInputGrid" MaxHeight="185" AutoGenerateColumns="False"
                                              AutomationProperties.AutomationId="CaseInputGrid" AutomationProperties.Name="평가 사례 입력" />
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="ComparisonTab" Header="실행 비교" AutomationProperties.AutomationId="ComparisonTab">
                            <Grid Margin="0,7,0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="OpenRunComparisonButton" Content="저장된 실행 비교" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OpenRunComparisonButton" Margin="0,0,0,6" />
                                <Grid x:Name="RunDiffPanel" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="RunDiffSummary" AutomationProperties.AutomationId="RunDiffSummary"
                                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource MetaText}"
                                               TextWrapping="Wrap" Margin="0,2,0,7" />
                                    <DataGrid x:Name="RunDiffGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                              AutomationProperties.AutomationId="RunDiffGrid" AutomationProperties.Name="저장 실행별 사례 판정 비교" />
                                </Grid>
                                <Expander Grid.Row="2" Header="현재 개정의 규칙·평가 참조"
                                          Style="{StaticResource EvidenceDisclosure}" Margin="0,6,0,0">
                                    <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="178"
                                              AutomationProperties.AutomationId="ComparisonGrid" AutomationProperties.Name="현재 개정의 규칙·평가 참조" />
                                </Expander>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="HistoryTab" Header="평가·결정 이력" AutomationProperties.AutomationId="HistoryTab">
                            <DockPanel>
                                <Button x:Name="CompareRunsButton" Content="저장된 실행 비교" DockPanel.Dock="Top"
                                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,7"
                                        AutomationProperties.AutomationId="CompareRunsButton" />
                                <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                          AutomationProperties.AutomationId="HistoryGrid" AutomationProperties.Name="평가·결정 이력" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>

                    <Border x:Name="DecisionBar" Grid.Row="2" Padding="16,7" MinHeight="49" Focusable="True"
                            BorderBrush="{StaticResource RuleBrush}"
                            BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="hold">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="9,0,0,0">
                                <Button x:Name="RejectButton" Content="반려 기록" AutomationProperties.AutomationId="RejectButton"
                                        Visibility="Collapsed" Margin="0,0,6,0" />
                                <Button x:Name="ApproveButton" Content="승인 기록" AutomationProperties.AutomationId="ApproveButton"
                                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                                <Button x:Name="EvaluateButton" Content="전체 사례 평가" AutomationProperties.AutomationId="EvaluateButton"
                                        Visibility="Collapsed" Margin="0,0,6,0" />
                                <Button x:Name="SubmitButton" Content="현업 검토 제출" AutomationProperties.AutomationId="SubmitButton"
                                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                                <Button x:Name="CorrectButton" Content="반려 변경 시정" AutomationProperties.AutomationId="CorrectButton"
                                        Visibility="Collapsed" />
                                <Button x:Name="RecoveryButton" Content="원래 요청 복구" AutomationProperties.AutomationId="RecoveryButton"
                                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="6,0,0,0" />
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ReviewSignal" AutomationProperties.AutomationId="ReviewSignal"
                                           AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" FontSize="12"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="DecisionStatus" Text="검토할 변경을 선택하세요."
                                           AutomationProperties.AutomationId="DecisionStatus" AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="ProofSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource PaneSplitter}" AutomationProperties.Name="검증 근거 폭 조절" />

                <Grid x:Name="ProofPane" Grid.Column="4" Background="{StaticResource CanvasBrush}"
                      AutomationProperties.AutomationId="ProofPane" AutomationProperties.Name="검증 근거 영역">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleBrush}" Padding="13,15,13,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="ProofTitle" Text="검증 근거" Style="{StaticResource SectionTitle}"
                                           AutomationProperties.AutomationId="ProofTitle" AutomationProperties.HeadingLevel="Level2"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="ProofStatus" Text="요청 선택 대기" Style="{StaticResource MetaText}"
                                       AutomationProperties.AutomationId="ProofStatus" AutomationProperties.LiveSetting="Polite"
                                       TextWrapping="Wrap" Margin="0,6,0,8" />
                            <WrapPanel>
                                <Button x:Name="EvidenceButton" Content="요청 근거" AutomationProperties.AutomationId="EvidenceButton"
                                        Margin="0,0,6,0" IsEnabled="False" />
                                <Button x:Name="CopyReferenceButton" Content="참조 복사" AutomationProperties.AutomationId="CopyReferenceButton"
                                        Style="{StaticResource QuietButton}" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="ProofTextScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="11,8,11,14">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,7">
                                <TextBox x:Name="ProofContent" AutomationProperties.AutomationId="ProofContent" AutomationProperties.Name="검증 근거 읽기"
                                         Text="요청을 선택하면 적용 조항, 사례 결과와 승인 당시 참조를 확인할 수 있습니다."
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12.5"
                                         Background="Transparent" BorderThickness="0" Padding="1" MinHeight="0"
                                         VerticalContentAlignment="Top" />
                            </Border>
                            <Expander x:Name="ProofAuditExpander" AutomationProperties.AutomationId="ProofAuditExpander"
                                      Header="감사 참조" IsExpanded="False" Visibility="Collapsed" Margin="0,9,0,0"
                                      Style="{StaticResource EvidenceDisclosure}">
                                <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource RuleBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,5,0,0">
                                    <TextBox x:Name="ProofAuditContent" AutomationProperties.AutomationId="ProofAuditContent"
                                             AutomationProperties.Name="근거 식별자와 해시" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas, Malgun Gothic"
                                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Padding="11,3" MinHeight="24" Background="{StaticResource QueueBrush}"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock Text="합성 검토 환경" DockPanel.Dock="Right" Style="{StaticResource MetaText}" Margin="9,0,0,0" />
                    <TextBlock x:Name="ConnectionText" Text="연결 확인 중" DockPanel.Dock="Right" Style="{StaticResource MetaText}"
                               AutomationProperties.AutomationId="ConnectionText" Margin="9,0,0,0" />
                    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource MetaText}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
